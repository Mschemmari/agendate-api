# API
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/agendate
# Leave MONGODB_URI empty to use in-memory MongoDB for local demo
JWT_SECRET=change-me-in-production
WEB_URL=https://agendate-api-web.vercel.app
API_URL=http://localhost:4000

# Email (optional — without RESEND_API_KEY, emails are logged to console)
RESEND_API_KEY=
EMAIL_FROM=Agendate <onboarding@resend.dev>

# WhatsApp Cloud API (bot de turnos)
# Webhook URL: https://<tu-api>/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=agendate-verify
WHATSAPP_APP_SECRET=
